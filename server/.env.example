# Must be a random secret of at least 16 characters; the placeholder below is
# rejected at startup. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GITHUB_NEWS_MASTER_KEY=replace-with-a-long-random-secret
GITHUB_NEWS_DB=data/github_news_server.db
GITHUB_NEWS_SCHEDULER_ENABLED=true
GITHUB_NEWS_INGEST_INTERVAL=900
GITHUB_NEWS_PUSH_INTERVAL=30
GITHUB_NEWS_REQUEST_TIMEOUT=30
# Webhook delivery refuses private/loopback/link-local targets by default (SSRF
# protection). Set to true only when deliberately delivering to LAN services.
GITHUB_NEWS_WEBHOOK_ALLOW_PRIVATE=false
# Comma-separated browser origin allowlist for CORS; unset allows any origin.
GITHUB_NEWS_CORS_ORIGINS=

# Optional publisher AI proxy. Secrets stay on the server.
AI_ENRICHMENT_AGNES_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AI_ENRICHMENT_USER_DAILY_LIMIT=20
AI_ENRICHMENT_GLOBAL_DAILY_LIMIT=500
